# Copy this file to ".env" and fill in the keys for the provider(s) you plan to use.
# You only need ONE of these — pick the LLM provider you'll select in the app sidebar.
# If you only plan to use Ollama (free, local, no API key needed), you can leave this
# file empty or skip creating .env entirely.

# Required if you select "OpenAI" as the LLM provider in the app
OPENAI_API_KEY=

# Required if you select "Anthropic" as the LLM provider in the app
ANTHROPIC_API_KEY=

# Required if you select "Mistral" as the LLM provider in the app
MISTRAL_API_KEY=
